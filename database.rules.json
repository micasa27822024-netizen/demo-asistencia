{
  "rules": {
    ".read": false,
    ".write": false,
    "configuracionAsistencia": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.role == 'admin'"
    },
    "configuracionEmpresa": {
      ".read": true,
      ".write": "auth != null && auth.token.role == 'admin'"
    },
    "personal": {
      ".indexOn": [
        "legajo",
        "authUid"
      ],
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && (auth.token.role == 'admin' || auth.token.role == 'supervisor')",
        ".validate": "newData.hasChildren(['legajo', 'nombre', 'estado']) && newData.child('legajo').isString()"
      }
    },
    "objetivos": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.role == 'admin' || auth.token.role == 'supervisor')"
    },
    "asignacionesTurnos": {
      ".indexOn": [
        "legajo",
        "fecha"
      ],
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && (auth.token.role == 'admin' || auth.token.role == 'supervisor')"
      }
    },
    "fichadas": {
      ".indexOn": [
        "legajo",
        "timestampServidor",
        "fechaHoraDispositivo"
      ],
      ".read": "auth != null",
      "$id": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.role == 'admin' || auth.token.role == 'supervisor' || !data.exists())"
      }
    },
    "fichadasPendientes": {
      ".indexOn": [
        "legajo",
        "estadoServidor"
      ],
      ".read": "auth != null && (auth.token.role == 'admin' || auth.token.role == 'supervisor')",
      "$id": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['legajo','authUid','tipo','objetivo','latitud','longitud','fechaHoraDispositivo'])"
      }
    },
    "alertasFichadas": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "alertasFichadasPendientes": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['legajo','authUid','tipoAlerta','fechaHora'])"
      }
    },
    "alertasLlegadasTarde": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "alertasSalidasAnticipadas": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "panicos": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    },
    "novedades": {
      ".indexOn": [
        "legajo",
        "fechaHora"
      ],
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    },
    "auditoria": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "credencialesWebAuthn": {
      ".read": false,
      ".write": false
    },
    "webAuthnChallenges": {
      ".read": false,
      ".write": false
    },
    "alertasFichadasEliminadas": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    }
  }
}
